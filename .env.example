# Copy to .env and fill in real values. Never commit .env.

# --- Database (Prisma / PostgreSQL) ---
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
# Direct (non-pooled) connection used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# --- Server ---
# Port the Express server listens on (default 5000).
PORT=5000
# Comma-separated list of allowed browser origins, or * for any (default *).
CORS_ORIGIN=http://localhost:3000

# --- Auth ---
# Secret used to sign/verify JWTs. Use a long random string; rotating it logs everyone out.
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime in jsonwebtoken/ms format, e.g. 1h, 12h, 7d (default 7d).
JWT_EXPIRES_IN=7d
# When true, enables the built-in demo personas (arjun/resident/admin, guard/vikram/security,
# plumber/raju, laundry/freshpress) that log in with ANY password if not found in the DB, and the
# demo fallback profile on /api/user/my. Never enable in production.
DEMO_MODE=false

# --- Cloudinary (profile image uploads on /api/user/signup) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- SMS OTP (Fast2SMS, used by middleware/auth.js sendOTP; OTP login is currently disabled) ---
FAST2SMS_API_KEY=your-fast2sms-api-key

# --- Twilio (legacy/optional: the twilio package is imported but not currently used by the code) ---
ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AUTH_TOKEN=your-twilio-auth-token
SERVICE_ID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
